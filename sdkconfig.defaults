# AudioESP – ESP32-DevKitC-VIE (ESP32-WROVER-IE, PSRAM 8 MB)
CONFIG_IDF_TARGET="esp32"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0

# PSRAM w module WROVER (quad SPI)
CONFIG_SPIRAM=y
# start także na płytce bez PSRAM (test Wi-Fi/panelu); Spotify wtedy nie rusza – patrz main.cpp
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
# bufory Wi-Fi/LWIP w PSRAM (na WROVER brakowało pamięci wewnętrznej; bez PSRAM i tak zostają w wewnętrznej)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_EN=n

CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=16
CONFIG_LWIP_MAX_LISTENING_TCP=16
CONFIG_LWIP_LOCAL_HOSTNAME="audio-mini"

# mbedtls: zwykłe przydzielanie pamięci (duże bufory TLS > 16 kB i tak idą do PSRAM). Wymuszenie PSRAM
# (EXTERNAL_MEM_ALLOC) psuło wymianę kluczy WPA2 na płytce bez PSRAM – router zrywał z kodem 1.
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_ECDH_LEGACY_CONTEXT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CMAC_C=y
# sprzętowe AES potrzebuje wewnętrznej pamięci DMA, której brakuje podczas odtwarzania
CONFIG_MBEDTLS_HARDWARE_AES=n

# Wi-Fi bez oszczędzania energii (stabilny strumień)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
